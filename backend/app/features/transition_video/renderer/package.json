{
  "name": "transition-video-renderer",
  "version": "1.0.0",
  "description": "Remotion renderer for transition videos",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "remotion bundle src/index.tsx --bundle-cache",
    "preview": "remotion preview src/index.tsx",
    "render": "remotion render src/index.tsx MainVideoTransition out/sample-transition.mp4 --props=test_props.json"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.327",
    "@remotion/cli": "^4.0.327",
    "@remotion/google-fonts": "^4.0.327",
    "@remotion/renderer": "^4.0.327",
    "express": "^4.18.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "^4.0.327",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.0",
    "nodemon": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
